  "networks": {
    "anvil": {
      "chainId": 31337,
      "rpcUrl": "http://127.0.0.1:8545",
      "startBlock": 4
    },
    "localhost": {
      "chainId": 31337,
      "rpcUrl": "http://127.0.0.1:8545",
      "startBlock": 1
    },
    "hardhat": {
      "chainId": 31337,
      "rpcUrl": "http://127.0.0.1:8545",
      "startBlock": 1
    }
  },
  "paths": {
    "deployments": "./deployments",
    "artifacts": "./out",
    "scripts": "./scripts-js",
    "contracts": "./contracts"
  }
