    },
    "ceremonyFacet": {
      "enabled": true
    },
    "votingFacet": {
      "enabled": true
    }
  },
  "scripts": {
    "deployScript": "script/DeployScrumPoker.s.sol",
    "initScript": "script/InitializeContracts.s.sol",
    "generateAbis": true,
    "updatePonder": true,
    "verbose": false
