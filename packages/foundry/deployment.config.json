{
  "deployment": {
    "defaultNetwork": "anvil",
    "defaultChainId": 31337,
    "defaultStartBlock": 4,
    "defaultPrivateKey": "0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80",
    "rpcUrl": "http://127.0.0.1:8545"
  },
  "ponder": {
